#cloud-config
# Yalnızca test: parolalar test değerleridir; svc-mail parolası tests/dc/cloud-init ile aynıdır.
hostname: mail
fqdn: mail.test.lan
prefer_fqdn_over_hostname: false
users:
  - name: librenfra
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys: ["@SSH_PUBKEY@"]
manage_etc_hosts: false
write_files:
  - path: /etc/hosts
    content: |
      127.0.0.1 localhost localhost.localdomain
      ::1       localhost localhost.localdomain
      10.99.0.20 mail.test.lan mail
      10.99.0.10 dc.test.lan dc
  - path: /etc/librenfra/mail.conf
    content: |
      LIBRENFRA_MAIL_DOMAINS=ornek.test
      LIBRENFRA_REALM=TEST.LAN
      LIBRENFRA_DC=dc.test.lan
  - path: /etc/librenfra/secrets/svc-mail
    permissions: "0600"
    content: "Svc-Mail-Parola-2026!"
  - path: /etc/librenfra/ca.pem
    encoding: b64
    content: "@B64:ca.pem@"
  - path: /etc/librenfra/mail-tls-cert.pem
    encoding: b64
    content: "@B64:mail.test.lan-cert.pem@"
  - path: /etc/librenfra/secrets/mail-tls-key.pem
    permissions: "0600"
    encoding: b64
    content: "@B64:mail.test.lan-key.pem@"
  - path: /etc/librenfra/secrets/dkim.key
    permissions: "0600"
    encoding: b64
    content: "@B64:dkim-key.pem@"
  - path: /etc/librenfra/secrets/mail-inbound-token
    permissions: "0600"
    content: "test-inbound-token"
  - path: /etc/containers/registries.conf.d/50-vmtest.conf
    content: |
      [[registry]]
      location = "10.0.2.2:5000"
      insecure = true
