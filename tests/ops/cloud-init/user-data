#cloud-config
# Yalnızca test: kayıt token'ı verilmez; runner'ın GitHub'a kaydı ortam testlerinde sınanır.
hostname: ops
fqdn: ops.test.lan
prefer_fqdn_over_hostname: false
users:
  - name: librenfra
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys: ["@SSH_PUBKEY@"]
manage_etc_hosts: false
write_files:
  - path: /etc/hosts
    content: |
      127.0.0.1 localhost localhost.localdomain
      ::1       localhost localhost.localdomain
      10.99.0.40 ops.test.lan ops
  - path: /etc/librenfra/ops.conf
    content: |
      LIBRENFRA_RUNNER_URL=https://github.com/Librenfra/librenfra
      LIBRENFRA_RUNNER_NAME=ops
      LIBRENFRA_RUNNER_LABELS=librenfra-ops
      LIBRENFRA_IMAGE_REPO=10.0.2.2:5000/librenfra/ops
  - path: /etc/librenfra/secrets/ops-ssh-key
    permissions: "0600"
    encoding: b64
    content: "@B64:ops-ssh-key@"
  - path: /etc/containers/registries.conf.d/50-vmtest.conf
    content: |
      [[registry]]
      location = "10.0.2.2:5000"
      insecure = true
