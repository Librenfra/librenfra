[Unit]
Description=Cloudflare tüneli
# Tünelin ayarı Cloudflare'dadır (infra/cloudflare); makinede yalnızca token bulunur.
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/librenfra/secrets/cloudflared-token

[Service]
DynamicUser=yes
LoadCredential=token:/etc/librenfra/secrets/cloudflared-token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file ${CREDENTIALS_DIRECTORY}/token
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
