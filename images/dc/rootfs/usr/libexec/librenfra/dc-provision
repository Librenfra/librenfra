#!/bin/bash
# Samba AD domain'ini kurar. Yalnızca /var/lib/samba/private altında hiç dosya yokken
# çalışır (paketlerin açtığı boş dizinler sayılmaz).
# Girdiler (/etc/librenfra/dc.conf):
#   LIBRENFRA_REALM          ör. KURUM.LAN
#   LIBRENFRA_DOMAIN         ör. KURUM
#   LIBRENFRA_DNS_FORWARDER  ör. 1.1.1.1
#   LIBRENFRA_ADDRESS        isteğe bağlı; Samba yalnızca bu adreste (ve lo'da) dinler ve
#                            DNS'e yalnızca bu adresi yazar
# LDAPS sertifikası (isteğe bağlı): /etc/librenfra/dc-tls-cert.pem, /etc/librenfra/ca.pem ve
# /etc/librenfra/secrets/dc-tls-key.pem. Yoksa Samba kendi imzaladığı sertifikayı üretir.
# Secret: yönetici parolası systemd credential olarak gelir (admin-password).
set -euo pipefail

: "${LIBRENFRA_REALM:?}" "${LIBRENFRA_DOMAIN:?}"

if [ -n "$(find /var/lib/samba/private -type f -print -quit 2>/dev/null)" ]; then
    echo "/var/lib/samba/private altında dosya var, domain kurulumu yapılmıyor" >&2
    exit 1
fi

pw_file="$CREDENTIALS_DIRECTORY/admin-password"
args=(
    --realm="$LIBRENFRA_REALM"
    --domain="$LIBRENFRA_DOMAIN"
    --server-role=dc
    --dns-backend=SAMBA_INTERNAL
    --use-rfc2307
    --adminpass="$(cat "$pw_file")"
)
if [ -n "${LIBRENFRA_DNS_FORWARDER:-}" ]; then
    args+=(--option="dns forwarder = $LIBRENFRA_DNS_FORWARDER")
fi
if [ -n "${LIBRENFRA_ADDRESS:-}" ]; then
    args+=(--host-ip="$LIBRENFRA_ADDRESS"
           --option="interfaces = lo $LIBRENFRA_ADDRESS"
           --option="bind interfaces only = yes")
fi
if [ -f /etc/librenfra/dc-tls-cert.pem ]; then
    args+=(--option="tls enabled = yes"
           --option="tls certfile = /etc/librenfra/dc-tls-cert.pem"
           --option="tls keyfile = /etc/librenfra/secrets/dc-tls-key.pem"
           --option="tls cafile = /etc/librenfra/ca.pem")
fi

# Samba'nın ürettiği smb.conf /etc'ye değil /var'a yazılır. /etc her deployment'ın kendi
# kopyasıdır; bootc rollback, domain kurulmadan önce hazırlanmış bir deployment'a dönerse
# /etc'ye yazılan dosya orada bulunmaz. İmajdaki /etc/samba/smb.conf bağlantısı
# /var/lib/samba/etc/smb.conf dosyasını gösterir.
samba-tool domain provision "${args[@]}"
