FROM quay.io/centos-bootc/centos-bootc:stream10

# Ortamı kuran ve güncelleyen makine: GitHub Actions runner'ı, OpenTofu ve Ansible.
# Sürümler imaja sabitlenir; runner kendini güncellemez (--disableupdate), yeni sürüm
# yeni bir imajla gelir. GitHub, runner'ın en geç 30 gün içinde güncellenmesini ister.
ARG TOFU_VERSION=1.13.2
ARG TOFU_SHA256=ac05d9952662c7db28dd57e93f0a68018837bfdf9342384ec0987977c16a9645
ARG RUNNER_VERSION=2.338.2
ARG RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40
# firewall/ayar.yml'nin OPNsense modülleri; python3-httpx bu koleksiyonun bağımlılığıdır.
ARG OPNSENSE_COLLECTION_VERSION=1.2.16
ARG OPNSENSE_COLLECTION_SHA256=2fb8411fdeb448cf8f075079c6d366e75e7f5eb704f4cfb8b94467ade0a4c50e

# lttng-ust, libicu ve krb5-libs runner'ın (.NET) bağımlılıklarıdır.
RUN dnf -y install --setopt=install_weak_deps=0 \
        cloud-init git-core jq rsync tar openssh-clients ansible-core python3-httpx \
        lttng-ust libicu krb5-libs \
    && dnf clean all \
    && rm -rf /var/cache/* /var/log/* /var/lib/dnf /run/*

RUN curl -fsSL -o /tmp/tofu.tar.gz \
        https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_amd64.tar.gz \
    && echo "${TOFU_SHA256}  /tmp/tofu.tar.gz" | sha256sum -c \
    && tar -xzf /tmp/tofu.tar.gz -C /usr/bin tofu \
    && rm /tmp/tofu.tar.gz \
    && mkdir -p /usr/lib/actions-runner \
    && curl -fsSL -o /tmp/runner.tar.gz \
        https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
    && echo "${RUNNER_SHA256}  /tmp/runner.tar.gz" | sha256sum -c \
    && tar -xzf /tmp/runner.tar.gz -C /usr/lib/actions-runner \
    && rm /tmp/runner.tar.gz \
    && echo "${RUNNER_VERSION}" > /usr/lib/actions-runner/librenfra-version \
    && curl -fsSL -o /tmp/ansibleguy-opnsense.tar.gz \
        https://galaxy.ansible.com/api/v3/plugin/ansible/content/published/collections/artifacts/ansibleguy-opnsense-${OPNSENSE_COLLECTION_VERSION}.tar.gz \
    && echo "${OPNSENSE_COLLECTION_SHA256}  /tmp/ansibleguy-opnsense.tar.gz" | sha256sum -c \
    && ansible-galaxy collection install --offline -p /usr/share/ansible/collections /tmp/ansibleguy-opnsense.tar.gz \
    && rm -rf /tmp/ansibleguy-opnsense.tar.gz /root/.ansible

COPY rootfs/ /
RUN chmod 0755 /usr/libexec/librenfra/* \
    && systemctl enable librenfra-data.service librenfra-runner-setup.service \
        librenfra-runner.service librenfra-self-update.path cloud-init.target \
    && systemctl mask bootc-fetch-apply-updates.timer

ARG VERSION=0.0.0-dev
LABEL org.opencontainers.image.version="${VERSION}"
RUN mkdir -p /usr/lib/librenfra && echo "${VERSION}" > /usr/lib/librenfra/ops-version
RUN bootc container lint
