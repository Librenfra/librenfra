[Unit]
Description=GitHub Actions runner
Requires=librenfra-runner-setup.service
After=librenfra-runner-setup.service
ConditionPathExists=/var/lib/librenfra/runner/.runner

[Service]
User=runner
WorkingDirectory=/var/lib/librenfra/runner
ExecStart=/var/lib/librenfra/runner/run.sh
Restart=always
RestartSec=30
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
