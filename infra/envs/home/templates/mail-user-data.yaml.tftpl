#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
prefer_fqdn_over_hostname: false
users:
  - name: librenfra
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys: ${jsonencode(ssh_authorized_keys)}
manage_etc_hosts: false
write_files:
  - path: /etc/hosts
    permissions: "0644"
    content: |
      127.0.0.1 localhost localhost.localdomain
      ::1       localhost localhost.localdomain
      ${ipv4_address} ${fqdn} ${hostname}
  - path: /etc/librenfra/mail.conf
    permissions: "0644"
    content: |
      LIBRENFRA_MAIL_DOMAINS="${join(" ", mail_domains)}"
      LIBRENFRA_REALM=${realm}
      LIBRENFRA_DC=${dc_fqdn}
  - path: /etc/librenfra/secrets/svc-mail
    permissions: "0600"
    content: ${jsonencode(svc_mail_password)}
  - path: /etc/librenfra/ca.pem
    permissions: "0644"
    content: ${jsonencode(ca_cert)}
  - path: /etc/librenfra/mail-tls-cert.pem
    permissions: "0644"
    content: ${jsonencode(tls_cert)}
  - path: /etc/librenfra/secrets/mail-tls-key.pem
    permissions: "0600"
    content: ${jsonencode(tls_key)}
%{ if cloudflared_token != null ~}
  - path: /etc/librenfra/secrets/cloudflared-token
    permissions: "0600"
    content: ${jsonencode(cloudflared_token)}
%{ endif ~}
%{ if mail_inbound_token != null ~}
  - path: /etc/librenfra/secrets/mail-inbound-token
    permissions: "0600"
    content: ${jsonencode(mail_inbound_token)}
%{ endif ~}
%{ if dkim_key != null ~}
  - path: /etc/librenfra/secrets/dkim.key
    permissions: "0600"
    content: ${jsonencode(dkim_key)}
%{ endif ~}
