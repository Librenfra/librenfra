#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
users:
  - name: librenfra
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys: ${jsonencode(ssh_authorized_keys)}
write_files:
  - path: /etc/librenfra/dc.conf
    permissions: "0644"
    content: |
      LIBRENFRA_REALM=${realm}
      LIBRENFRA_DOMAIN=${netbios_domain}
      LIBRENFRA_DNS_FORWARDER=${dns_forwarder}
  - path: /etc/krb5.conf.d/librenfra-realm
    permissions: "0644"
    content: |
      [libdefaults]
          default_realm = ${realm}
          dns_lookup_realm = false
          dns_lookup_kdc = true
  - path: /etc/librenfra/secrets/dc-admin-password
    permissions: "0600"
    content: ${jsonencode(admin_password)}
